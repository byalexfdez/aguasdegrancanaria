# ---------------------------------------------------------------------------
# Consejo Insular de Aguas de Gran Canaria · generado por scripts/despliegue/redirecciones.mjs
# No editar a mano: regenerar con «npm run redirecciones».
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(css|js|woff2?|webp|avif|jpe?g|png|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Dominio oficial sin www → con www (solo afecta a aguasgrancanaria.com; en otros dominios no hace nada)
  RewriteCond %{HTTP_HOST} ^aguasgrancanaria\.com$ [NC]
  RewriteRule ^ https://www.aguasgrancanaria.com%{REQUEST_URI} [R=301,L,NE]
  # Forzar HTTPS en el dominio en que se publique (sin bucle detrás de proxy nginx/Plesk)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Inicio de sesión del gestor de contenidos (PHP): nunca se redirige
  RewriteRule ^admin/oauth/ - [L]

  # Las fichas del Censo de Instalaciones siguen sirviéndose desde su carpeta original (no se migran).
  RewriteRule ^cartografia/CIfichas/ - [L]

  # 1360 redirecciones de la web anterior (páginas, documentos, imágenes, vídeos y visores)
  RewriteRule ^accesibilidad\.php$ /accesibilidad/ [R=301,L,NE]
  RewriteRule ^agua/desaladoras\.php$ /agua-en-gran-canaria/desaladoras/ [R=301,L,NE]
  RewriteRule ^ayudas\.php$ /transparencia/ayudas-y-subvenciones/ [R=301,L,NE]
  RewriteRule ^cartografia\.php$ /mapas-y-cartografia/ [R=301,L,NE]
  RewriteRule ^cartografia/Catalogo_Cauces/index\.html$ /agua-en-gran-canaria/inventario-insular-de-cauces/ [R=301,L,NE]
  RewriteRule ^cartografia/CensoInstalaciones/map-censo\.html$ /agua-en-gran-canaria/instalaciones-hidraulicas-subterraneas/ [R=301,L,NE]
  RewriteRule ^cartografia/gestion\.php$ /mapas-y-cartografia/gestion-del-agua/ [R=301,L,NE]
  RewriteRule ^cartografia/gestion/pluviometria\.php$ /mapas-y-cartografia/gestion-del-agua/pluviometria/ [R=301,L,NE]
  RewriteRule ^cartografia/gestion/redes\.php$ /mapas-y-cartografia/gestion-del-agua/redes-de-control/ [R=301,L,NE]
  RewriteRule ^cartografia/infraestructura\.php$ /mapas-y-cartografia/infraestructuras-hidraulicas/ [R=301,L,NE]
  RewriteRule ^cartografia/infraestructura/consejo\.php$ /mapas-y-cartografia/infraestructuras-hidraulicas/infraestructuras-del-consejo/ [R=301,L,NE]
  RewriteRule ^cartografia/infraestructura/depuradoras\.php$ /mapas-y-cartografia/infraestructuras-hidraulicas/depuradoras-y-desaladoras/ [R=301,L,NE]
  RewriteRule ^cartografia/infraestructura/pozos\.php$ /mapas-y-cartografia/infraestructuras-hidraulicas/pozos/ [R=301,L,NE]
  RewriteRule ^cartografia/infraestructura/presas\.php$ /mapas-y-cartografia/infraestructuras-hidraulicas/presas/ [R=301,L,NE]
  RewriteRule ^cartografia/marco\.php$ /mapas-y-cartografia/marco-administrativo/ [R=301,L,NE]
  RewriteRule ^cartografia/marco/masas\.php$ /mapas-y-cartografia/marco-administrativo/masas-de-agua/ [R=301,L,NE]
