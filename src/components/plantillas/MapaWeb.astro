---

import { secciones, legales, transversales } from '../../lib/navegacion';

---

<div class="grid gap-10 md:grid-cols-2 xl:grid-cols-3">

  {secciones.map((s) => (

    <section>

      <h2 class="font-display text-xl font-bold"><a href={s.url} class="no-underline">{s.titulo}</a></h2>

      <ul class="mt-3 grid gap-1 text-[.95rem]">

        {(s.hijos ?? []).map((h) => (

          <li>

            <a href={h.url} {...(h.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{h.titulo}</a>

            {(h.hijos ?? []).length > 0 && (

              <ul class="ml-4 mt-1 grid gap-0.5 border-l border-borde pl-3 text-sm">

                {h.hijos!.map((x) => (

                  <li><a href={x.url} class="text-texto-suave">{x.titulo}</a>

                    {(x.hijos ?? []).length > 0 && <ul class="ml-3 grid gap-0.5 border-l border-borde pl-3">{x.hijos!.map((y) => <li><a href={y.url} class="text-texto-suave">{y.titulo}</a></li>)}</ul>}

                  </li>

                ))}

              </ul>

            )}

          </li>

        ))}

      </ul>

    </section>

  ))}

  <section>

    <h2 class="font-display text-xl font-bold">Otras páginas</h2>

    <ul class="mt-3 grid gap-1">{[...transversales, ...legales].map((n) => <li><a href={n.url}>{n.titulo}</a></li>)}</ul>

  </section>

</div>

