---
// Avisos y alertas (colección editable desde el CMS). Los activos se muestran además bajo la cabecera de todo el sitio.
import { getCollection } from 'astro:content';
import Icono from '../Icono.astro';
import { fechaLarga, fechaISO } from '../../lib/formato';
const avisos = (await getCollection('avisos')).sort((a, b) => Number(b.data.activo) - Number(a.data.activo) || (b.data.fecha?.getTime() ?? 0) - (a.data.fecha?.getTime() ?? 0));
const activos = avisos.filter((a) => a.data.activo);
const historico = avisos.filter((a) => !a.data.activo);
---
<section aria-labelledby="t-activos">
  <h2 id="t-activos" class="font-display text-2xl font-bold">Avisos en vigor</h2>
  {activos.length === 0
    ? <p class="mt-3 tarjeta p-5 flex items-center gap-3"><Icono nombre="info" clase="text-marca-700" /> No hay avisos activos en este momento.</p>
    : <ul class="mt-4 grid gap-3">{activos.map((a) => (
        <li class="tarjeta p-5 border-l-4 !border-l-alerta-700">
          <p class="font-display text-lg font-bold">{a.data.titulo}</p>
          {a.data.fecha && <time class="text-sm text-texto-suave" datetime={fechaISO(a.data.fecha)}>{fechaLarga(a.data.fecha)}</time>}
          {a.data.enlace && <p class="mt-2"><a href={a.data.enlace}>{a.data.subtitulo ?? 'Más información'}</a></p>}
        </li>))}</ul>}
</section>
{historico.length > 0 && (
  <section class="mt-12" aria-labelledby="t-hist">
    <h2 id="t-hist" class="font-display text-2xl font-bold">Avisos anteriores</h2>
    <ul class="mt-4 grid gap-3">
      {historico.map((a) => (
        <li class="tarjeta p-5">
          <p class="font-semibold">{a.data.titulo}</p>
          {a.data.fecha && <time class="text-sm text-texto-suave" datetime={fechaISO(a.data.fecha)}>{fechaLarga(a.data.fecha)}</time>}
          {a.data.enlace && <p class="mt-2"><a href={a.data.enlace} class:list={[/^\/documentos\//.test(a.data.enlace) && 'doc-link']} data-formato={/\.pdf$/i.test(a.data.enlace) ? 'pdf' : undefined}>{a.data.subtitulo ?? 'Más información'}</a></p>}
        </li>
      ))}
    </ul>
  </section>
)}
