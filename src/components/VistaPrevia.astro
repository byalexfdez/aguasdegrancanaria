---
// Botón «Vista previa» para documentos PDF (abre el visor común definido en Base.astro).
interface Props { src: string; titulo?: string | null }
const { src, titulo } = Astro.props;
const esPdf = /\.pdf$/i.test(src.split('?')[0]);
---
{esPdf && (
  <button type="button" class="boton-visor" data-visor-pdf={src} data-titulo={titulo ?? 'Documento PDF'}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
    Vista previa<span class="sr-only">: {titulo ?? 'documento PDF'}</span>
  </button>
)}
