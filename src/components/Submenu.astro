---
// Submenú lateral sticky de la sección actual (árbol plegable).
import Icono from './Icono.astro';
import { seccionDe, visibles, contiene, type Nodo } from '../lib/navegacion';
interface Props { url: string }
const { url } = Astro.props;
const seccion = seccionDe(url);
---
{seccion && (
  <nav aria-label={`Sección: ${seccion.titulo}`} class="lg:sticky lg:top-28">
    <details class="lg:hidden tarjeta p-4 group">
      <summary class="flex items-center justify-between font-display font-bold cursor-pointer list-none">
        <span>En esta sección: {seccion.titulo}</span><Icono nombre="abajo" tam={18} clase="group-open:rotate-180 transition-transform" />
      </summary>
      <ul class="mt-3 grid gap-0.5">
        <li><a href={seccion.url} class="block py-1.5" aria-current={seccion.url === url ? 'page' : undefined}>{seccion.titulo}</a></li>
        {visibles(seccion).map((h) => <li><a href={h.url} class:list={['block py-1.5 pl-3', contiene(h, url) && 'font-bold']} aria-current={h.url === url ? 'page' : undefined}>{h.titulo}</a></li>)}
      </ul>
    </details>
    <div class="hidden lg:block">
      <a href={seccion.url} class="antetitulo no-underline hover:underline">{seccion.titulo}</a>
      <ul class="mt-3 grid gap-0.5 border-l border-borde">
        {visibles(seccion).map((h) => {
          const dentro = contiene(h, url);
          const sub = visibles(h);
          return (
            <li>
              <a href={h.url} {...(h.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})} aria-current={h.url === url ? 'page' : undefined}
                class:list={['block -ml-px border-l-2 py-1.5 pl-4 pr-2 text-[.93rem] no-underline transition-colors', h.url === url ? 'border-marca-600 font-bold text-marca-800 bg-marca-50 dark:bg-marca-900 dark:text-white' : dentro ? 'border-marca-300 font-semibold text-texto' : 'border-transparent text-texto-suave hover:text-texto hover:border-basalto-300']}>
                {h.titulo}{h.externo && <Icono nombre="externo" tam={12} clase="inline ml-1 opacity-60" />}
              </a>
              {dentro && sub.length > 0 && (
                <ul class="ml-4 my-1 grid gap-0.5 border-l border-borde">
                  {sub.map((s) => (
                    <li>
                      <a href={s.url} aria-current={s.url === url ? 'page' : undefined} class:list={['block -ml-px border-l-2 py-1 pl-3 text-[.86rem] no-underline', contiene(s, url) ? 'border-marca-600 font-semibold text-marca-800 dark:text-white' : 'border-transparent text-texto-suave hover:text-texto']}>{s.titulo}</a>
                      {contiene(s, url) && visibles(s).length > 0 && (
                        <ul class="ml-3 grid">
                          {visibles(s).map((t) => <li><a href={t.url} aria-current={t.url === url ? 'page' : undefined} class:list={['block py-1 pl-3 text-[.82rem] no-underline', t.url === url ? 'font-semibold text-marca-800 dark:text-white' : 'text-texto-suave hover:text-texto']}>{t.titulo}</a></li>)}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
)}
